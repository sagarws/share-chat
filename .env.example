# Copy to .env for local development. On Render/Vercel, set these in the
# dashboard instead — never commit real values.

# --- Auth -------------------------------------------------------------------
# The shared login password. Only used to seed a fresh database, so it is also
# the password again after every redeploy (data/app.db is wiped).
INITIAL_PASSWORD=7698421288

# Signs session tokens. Keep it stable across deploys or everyone is logged out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Server -----------------------------------------------------------------
# Port 3000 is often taken locally; the server tries the next free port.
PORT=3000

# SQLite location. Defaults to ./data/app.db. On Vercel use /tmp/app.db
# (the rest of the filesystem is read-only).
# DB_PATH=/tmp/app.db

# Public origin, e.g. https://share-chat.onrender.com. Pins the Google OAuth
# redirect (<APP_URL>/oauth2callback) when proxy headers are wrong.
# APP_URL=

# --- Google Drive (File Share page) -----------------------------------------
# OAuth client from Google Cloud Console. Every origin needs
# <origin>/oauth2callback in the client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token for the shared Drive (get one with
# scripts/get-google-refresh-token.js — needs port 3000 free).
GOOGLE_REFRESH_TOKEN=

# Folders to show, seeded when the folder table is empty:
#   <folderId>|Name,<folderId>|Other name
GOOGLE_DRIVE_FOLDERS=

# Legacy single-folder form, used only if GOOGLE_DRIVE_FOLDERS is empty.
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_FOLDER_NAME=Shared files

# --- Uploads ----------------------------------------------------------------
# Max upload size in bytes. 0 or unset = no limit.
# MAX_UPLOAD_BYTES=0
