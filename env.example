# Share Chat — copy to .env and fill in. Keep real values out of this file.
# On Render these are set in the dashboard, not in render.yaml.

# --- Server ---
# Port 3000 is usually taken locally; 3100 works.
PORT=3100
# Optional. Defaults to ./data/app.db
DB_PATH=

# --- Auth ---
# Signs session tokens. Set it so sessions survive a DB wipe / redeploy.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Chat password used when the DB has no password yet.
INITIAL_PASSWORD=

# --- Google Drive (File Share page) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Get it with: node scripts/get-google-refresh-token.js (needs port 3000 free)
GOOGLE_REFRESH_TOKEN=

# Folders seeded when the folder list is empty. Use EITHER the list form:
#   GOOGLE_DRIVE_FOLDERS=<folderId>|<Name>,<folderId>|<Name>
GOOGLE_DRIVE_FOLDERS=
# ...OR a single folder:
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=Shared files

# --- Uploads ---
# Max upload size in bytes. 0 or empty = no limit.
MAX_UPLOAD_BYTES=
